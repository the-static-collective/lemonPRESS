{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/recipient-mailer/job.schema.json",
  "title": "lemonPRESS Recipient Mailer 001 job",
  "type": "object",
  "required": [
    "work_id",
    "edition_id",
    "title",
    "source_artifact",
    "recipient",
    "cover_note"
  ],
  "properties": {
    "work_id": {"type": "string", "minLength": 1},
    "edition_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "source_artifact": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "recipient": {
      "type": "object",
      "required": ["recipient_id", "display_name", "address_lines"],
      "properties": {
        "recipient_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "attention": {"type": "string"},
        "address_lines": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "cover_note": {
      "type": "object",
      "required": ["body"],
      "properties": {
        "heading": {"type": "string"},
        "body": {"type": "string", "minLength": 1},
        "signoff": {"type": "string"}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "address_disposition": {"const": "local_only"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
