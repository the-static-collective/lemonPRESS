{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-reletter-candidate-v0.schema.json",
  "title": "lemonpress/manga-reletter-candidate/v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-reletter-candidate/v0"
    },
    "status": {
      "const": "CANDIDATE"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "recipeSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relaySpecSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relayCandidateId": {
      "type": "string",
      "pattern": "^manga-translation-relay:[0-9a-f]{64}$"
    },
    "relayReturnTextSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage": {
      "const": "return"
    },
    "parent": {
      "type": "object"
    },
    "transformations": {
      "type": "array",
      "minItems": 1
    },
    "outputImage": {
      "type": "object",
      "properties": {
        "mediaType": {
          "const": "image/png"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pixelDimensions": {
          "type": "object"
        }
      },
      "required": [
        "mediaType",
        "sha256",
        "pixelDimensions"
      ],
      "additionalProperties": false
    },
    "effectiveGrants": {
      "type": "object"
    },
    "authority": {
      "type": "object",
      "properties": {
        "editorialSelection": {
          "const": false
        },
        "editionAdmission": {
          "const": false
        },
        "publication": {
          "const": false
        },
        "houseRelease": {
          "const": false
        }
      },
      "required": [
        "editorialSelection",
        "editionAdmission",
        "publication",
        "houseRelease"
      ],
      "additionalProperties": false
    },
    "wrench": {
      "type": "object"
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidateId": {
      "type": "string",
      "pattern": "^manga-reletter:[0-9a-f]{64}$"
    },
    "candidateHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "status",
    "title",
    "recipeSha256",
    "relaySpecSha256",
    "relayCandidateId",
    "relayReturnTextSha256",
    "stage",
    "parent",
    "transformations",
    "outputImage",
    "effectiveGrants",
    "authority",
    "wrench",
    "laws",
    "candidateId",
    "candidateHash"
  ],
  "additionalProperties": false
}
