{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/lemonPRESS/schemas/manga-parcel-v0.schema.json",
  "title": "LemonPRESS MangaParcelV0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parcel_id",
    "status",
    "title",
    "created_at",
    "source",
    "rights",
    "plan_sha256",
    "issue_plan",
    "descendant_slots",
    "laws"
  ],
  "properties": {
    "schema": {
      "const": "lemonpress.manga-parcel/v0"
    },
    "parcel_id": {
      "type": "string",
      "pattern": "^manga-parcel:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "INCUBATING",
        "ADMITTED",
        "RELEASED",
        "RETIRED"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "provider",
        "provider_file_id",
        "file_name",
        "media_type",
        "byte_length",
        "sha256",
        "pixel_dimensions",
        "locator"
      ],
      "properties": {
        "kind": {
          "const": "image"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "provider_file_id": {
          "type": "string",
          "minLength": 1
        },
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "const": "image/png"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pixel_dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "verification",
        "note"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issue_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "render_rule",
        "pages"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "render_rule": {
          "type": "string",
          "minLength": 1
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page",
              "label",
              "source_region_px"
            ],
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "source_region_px": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "descendant_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "media_type",
          "state"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "UNBORN",
              "CANDIDATE",
              "ADMITTED",
              "RETIRED"
            ]
          }
        }
      }
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
