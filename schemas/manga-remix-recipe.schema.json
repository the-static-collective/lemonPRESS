{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-remix-recipe.schema.json",
  "title": "lemonpress/manga-remix-recipe/v0",
  "type": "object",
  "properties": {
    "schema": {"const": "lemonpress/manga-remix-recipe/v0"},
    "title": {"type": "string", "minLength": 1},
    "canvasPx": {
      "type": "object",
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "required": ["width", "height"],
      "additionalProperties": false
    },
    "backgroundRgba": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 255},
        {"type": "integer", "minimum": 0, "maximum": 255},
        {"type": "integer", "minimum": 0, "maximum": 255},
        {"type": "integer", "minimum": 0, "maximum": 255}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "parents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "parentId": {"type": "string", "minLength": 1},
          "editionManifest": {"$ref": "manga-common.schema.json#/$defs/binding"},
          "pageManifest": {"$ref": "manga-common.schema.json#/$defs/binding"}
        },
        "required": ["parentId", "editionManifest", "pageManifest"],
        "additionalProperties": false
      }
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "placementId": {"type": "string", "minLength": 1},
          "parentId": {"type": "string", "minLength": 1},
          "sourceRectPx": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {"type": "integer", "minimum": 0},
                  "y": {"type": "integer", "minimum": 0},
                  "width": {"type": "integer", "minimum": 1},
                  "height": {"type": "integer", "minimum": 1}
                },
                "required": ["x", "y", "width", "height"],
                "additionalProperties": false
              },
              {"type": "null"}
            ]
          },
          "destinationRectPx": {
            "type": "object",
            "properties": {
              "x": {"type": "integer", "minimum": 0},
              "y": {"type": "integer", "minimum": 0},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1}
            },
            "required": ["x", "y", "width", "height"],
            "additionalProperties": false
          },
          "rotateDeg": {"enum": [0, 90, 180, 270]},
          "mirrorX": {"type": "boolean"},
          "mirrorY": {"type": "boolean"},
          "opacity": {"type": "integer", "minimum": 0, "maximum": 255},
          "resample": {"const": "nearest"}
        },
        "required": ["placementId", "parentId", "sourceRectPx", "destinationRectPx", "rotateDeg", "mirrorX", "mirrorY", "opacity", "resample"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "title", "canvasPx", "backgroundRgba", "parents", "placements"],
  "additionalProperties": false
}
