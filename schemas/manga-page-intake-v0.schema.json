{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-page-intake-v0.schema.json",
  "title": "lemonpress/manga-page-intake/v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-page-intake/v0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "EXECUTION_WITNESS"
    },
    "bundle_path": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "const": "application/pdf"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type",
        "page_count",
        "revision"
      ],
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "properties": {
        "engine": {
          "const": "pypdfium2"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scale_milli": {
          "type": "integer",
          "minimum": 1
        },
        "pixel_mode": {
          "const": "RGB"
        },
        "png_encoder": {
          "const": "lemonpress-stored-deflate-rgb8-v0"
        }
      },
      "required": [
        "engine",
        "version",
        "scale_milli",
        "pixel_mode",
        "png_encoder"
      ],
      "additionalProperties": false
    },
    "manga": {
      "type": "object",
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "edition_id": {
          "type": "string",
          "minLength": 1
        },
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "page_prefix": {
          "type": "string",
          "minLength": 1
        },
        "geometry": {
          "type": "object"
        }
      },
      "required": [
        "work_id",
        "edition_id",
        "issue_id",
        "page_prefix",
        "geometry"
      ],
      "additionalProperties": false
    },
    "admission": {
      "type": "object",
      "properties": {
        "authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "rights_note": {
          "type": "string",
          "minLength": 1
        },
        "grants": {
          "type": "object",
          "properties": {
            "pixelReuse": {
              "type": "boolean"
            },
            "pixelHarvest": {
              "type": "boolean"
            },
            "derivativeReuse": {
              "type": "boolean"
            },
            "publicationReuse": {
              "type": "boolean"
            },
            "motionAdaptation": {
              "type": "boolean"
            },
            "synthesizedSound": {
              "type": "boolean"
            }
          },
          "required": [
            "pixelReuse",
            "pixelHarvest",
            "derivativeReuse",
            "publicationReuse",
            "motionAdaptation",
            "synthesizedSound"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "authority_ref",
        "scope",
        "rights_note",
        "grants"
      ],
      "additionalProperties": false
    },
    "expected_pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "pixel_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "png_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "page",
          "width",
          "height",
          "pixel_sha256",
          "png_sha256"
        ],
        "additionalProperties": false
      }
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "status",
    "bundle_path",
    "source",
    "renderer",
    "manga",
    "admission",
    "laws"
  ],
  "additionalProperties": false
}
