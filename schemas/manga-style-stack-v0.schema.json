{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "lemonpress/manga-style-stack/v0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "styleId": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer"
          },
          "mode": {
            "enum": [
              "global",
              "channel-scoped",
              "domain-scoped"
            ]
          },
          "domainMask": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "languageBehavior",
                "textChannels",
                "visualPalette",
                "panelBehavior",
                "tone",
                "worldMotifs"
              ]
            }
          },
          "channelMask": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "handwriting",
                "meta_text",
                "caption",
                "screen_ui",
                "title_card",
                "signage",
                "embedded_source_text",
                "world_text",
                "dialogue",
                "sfx"
              ]
            }
          },
          "overrides": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "languageBehavior.sourceTraceVisible",
                "languageBehavior.routeVisible",
                "languageBehavior.glossLanguage",
                "languageBehavior.primaryLanguage",
                "textChannels.handwriting",
                "textChannels.meta_text",
                "textChannels.caption",
                "textChannels.screen_ui",
                "textChannels.title_card",
                "textChannels.signage",
                "textChannels.embedded_source_text",
                "textChannels.world_text",
                "textChannels.dialogue",
                "textChannels.sfx",
                "visualPalette.colors",
                "visualPalette.light",
                "visualPalette.contrast",
                "panelBehavior.insets",
                "panelBehavior.rhythm",
                "panelBehavior.architecture",
                "tone.warmth",
                "tone.presence",
                "tone.tension",
                "worldMotifs.rooms",
                "worldMotifs.artifacts",
                "worldMotifs.doors",
                "worldMotifs.receipts",
                "worldMotifs.screens"
              ]
            }
          }
        },
        "required": [
          "styleId",
          "priority",
          "mode",
          "domainMask",
          "overrides"
        ]
      }
    },
    "resolutionPolicy": {
      "enum": [
        "refuse-conflicts",
        "explicit-priority"
      ]
    },
    "laws": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "styles",
    "resolutionPolicy",
    "laws"
  ]
}
