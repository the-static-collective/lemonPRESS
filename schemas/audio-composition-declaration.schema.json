{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/audio-composition-declaration.schema.json",
  "title": "lemonPRESS Audio Composition Declaration v0",
  "type": "object",
  "required": ["schema", "work_id", "edition_id", "segments"],
  "properties": {
    "schema": { "const": "lemonpress/audio-composition-declaration/v0" },
    "work_id": { "type": "string", "minLength": 1 },
    "edition_id": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sequence", "duration_seconds", "manuscript", "layers"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 0 },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "manuscript": {
            "type": "object",
            "required": ["start_line", "end_line"],
            "properties": {
              "start_line": { "type": "integer", "minimum": 1 },
              "end_line": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "layers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["parcel_id", "role"],
              "properties": {
                "parcel_id": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "minLength": 1 },
                "order": { "type": "integer" },
                "start_offset_seconds": { "type": "number", "minimum": 0 },
                "duration_seconds": { "type": "number", "minimum": 0 },
                "trim_start_seconds": { "type": "number", "minimum": 0 },
                "gain_db": { "type": "number", "minimum": -96, "maximum": 24 },
                "duck_under_roles": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          },
          "transition_after": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["cut", "crossfade", "gap"] },
              "duration_seconds": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
