{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-root-fork/v0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "donor": {
      "type": "object",
      "properties": {
        "workId": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "sourceState": {
          "type": "string",
          "minLength": 1
        },
        "byteVerification": {
          "enum": [
            "external-declaration",
            "local-verified"
          ]
        }
      },
      "required": [
        "workId",
        "artifact",
        "sha256",
        "bytes",
        "pages",
        "sourceState",
        "byteVerification"
      ],
      "additionalProperties": false
    },
    "siblings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "declaration": {
            "type": "string",
            "pattern": "^branch-[a-z0-9-]+\\.json$"
          },
          "admission": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "admitted"
                ]
              },
              "receipt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "state",
              "receipt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "declaration",
          "admission"
        ],
        "additionalProperties": false
      }
    },
    "sharedRegions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "page",
          "region"
        ],
        "additionalProperties": false
      }
    },
    "laws": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "properties": {
        "houseAdmission": {
          "const": false
        },
        "publication": {
          "const": false
        },
        "canonOverSibling": {
          "const": false
        }
      },
      "required": [
        "houseAdmission",
        "publication",
        "canonOverSibling"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "donor",
    "siblings",
    "sharedRegions",
    "laws",
    "authority"
  ],
  "additionalProperties": false
}
