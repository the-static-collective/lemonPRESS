{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-reletter-recipe-v0.schema.json",
  "title": "lemonpress/manga-reletter-recipe/v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-reletter-recipe/v0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "relaySpec": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "return"
    },
    "parent": {
      "type": "object",
      "properties": {
        "parentId": {
          "type": "string",
          "minLength": 1
        },
        "pageManifest": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "parentId",
        "pageManifest"
      ],
      "additionalProperties": false
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "placementId": {
            "type": "string",
            "minLength": 1
          },
          "segmentId": {
            "type": "string",
            "minLength": 1
          },
          "rectPx": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "style": {
            "type": "object",
            "properties": {
              "backgroundRgba": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "foregroundRgba": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "font": {
                "const": "pillow-default"
              },
              "fontPx": {
                "type": "integer",
                "minimum": 1,
                "maximum": 96
              },
              "paddingPx": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              },
              "lineSpacingPx": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "align": {
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              }
            },
            "required": [
              "backgroundRgba",
              "foregroundRgba",
              "font",
              "fontPx",
              "paddingPx",
              "lineSpacingPx",
              "align"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "placementId",
          "segmentId",
          "rectPx",
          "style"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "title",
    "relaySpec",
    "stage",
    "parent",
    "placements"
  ],
  "additionalProperties": false
}
