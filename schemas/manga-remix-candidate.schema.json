{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-remix-candidate.schema.json",
  "title": "lemonpress/manga-remix-candidate/v0",
  "type": "object",
  "properties": {
    "schema": {"const": "lemonpress/manga-remix-candidate/v0"},
    "status": {"const": "CANDIDATE"},
    "title": {"type": "string", "minLength": 1},
    "recipeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "parentId": {"type": "string", "minLength": 1},
          "editionManifest": {"$ref": "manga-common.schema.json#/$defs/binding"},
          "pageManifest": {"$ref": "manga-common.schema.json#/$defs/binding"},
          "identity": {"$ref": "manga-common.schema.json#/$defs/identity"}
        },
        "required": ["parentId", "editionManifest", "pageManifest", "identity"],
        "additionalProperties": false
      }
    },
    "canvasPx": {
      "type": "object",
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "required": ["width", "height"],
      "additionalProperties": false
    },
    "backgroundRgba": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 255},
        {"type": "integer", "minimum": 0, "maximum": 255},
        {"type": "integer", "minimum": 0, "maximum": 255},
        {"type": "integer", "minimum": 0, "maximum": 255}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "transformations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "placementId": {"type": "string", "minLength": 1},
          "parentId": {"type": "string", "minLength": 1},
          "sourceRectPx": {"type": ["object", "null"]},
          "destinationRectPx": {"type": "object"},
          "rotateDeg": {"enum": [0, 90, 180, 270]},
          "mirrorX": {"type": "boolean"},
          "mirrorY": {"type": "boolean"},
          "opacity": {"type": "integer", "minimum": 0, "maximum": 255},
          "resample": {"const": "nearest"}
        },
        "required": ["placementId", "parentId", "sourceRectPx", "destinationRectPx", "rotateDeg", "mirrorX", "mirrorY", "opacity", "resample"],
        "additionalProperties": false
      }
    },
    "outputImage": {
      "type": "object",
      "properties": {
        "mediaType": {"const": "image/png"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pixelDimensions": {
          "type": "object",
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          },
          "required": ["width", "height"],
          "additionalProperties": false
        }
      },
      "required": ["mediaType", "sha256", "pixelDimensions"],
      "additionalProperties": false
    },
    "effectiveGrants": {"$ref": "manga-common.schema.json#/$defs/grants"},
    "authority": {
      "type": "object",
      "properties": {
        "editorialSelection": {"const": false},
        "editionAdmission": {"const": false},
        "publication": {"const": false},
        "houseRelease": {"const": false}
      },
      "required": ["editorialSelection", "editionAdmission", "publication", "houseRelease"],
      "additionalProperties": false
    },
    "wrench": {
      "type": "object",
      "properties": {
        "INPUT": {"type": "array", "minItems": 1, "items": {"$ref": "manga-common.schema.json#/$defs/identity"}},
        "TRANSFORMATION": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "OUTPUT": {
          "type": "object",
          "properties": {
            "mediaType": {"const": "image/png"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "required": ["mediaType", "sha256"],
          "additionalProperties": false
        },
        "RESIDUAL": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "LOSS": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "UNKNOWN": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "STOP": {"type": "string", "minLength": 1}
      },
      "required": ["INPUT", "TRANSFORMATION", "OUTPUT", "RESIDUAL", "LOSS", "UNKNOWN", "STOP"],
      "additionalProperties": false
    },
    "laws": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidateId": {"type": "string", "pattern": "^manga-remix:[0-9a-f]{64}$"},
    "candidateHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["schema", "status", "title", "recipeSha256", "parents", "canvasPx", "backgroundRgba", "transformations", "outputImage", "effectiveGrants", "authority", "wrench", "laws", "candidateId", "candidateHash"],
  "additionalProperties": false
}
