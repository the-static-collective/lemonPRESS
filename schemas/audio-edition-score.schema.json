{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/audio-edition-score.schema.json",
  "title": "lemonPRESS Audio Edition Score v0",
  "type": "object",
  "required": [
    "schema",
    "work_id",
    "edition_id",
    "profile",
    "authority",
    "manuscript",
    "declaration",
    "parcels",
    "segments",
    "score_hash"
  ],
  "properties": {
    "schema": { "const": "lemonpress/audio-edition-score/v0" },
    "work_id": { "type": "string", "minLength": 1 },
    "edition_id": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "authority": { "const": "composition-proposal" },
    "score_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manuscript": {
      "type": "object",
      "required": ["sha256", "byte_length", "line_count"]
    },
    "declaration": {
      "type": "object",
      "required": ["sha256"]
    },
    "parcels": { "type": "array", "minItems": 1 },
    "segments": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": true
}
