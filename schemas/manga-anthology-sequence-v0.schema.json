{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-anthology-sequence-v0.schema.json",
  "title": "lemonpress/manga-anthology-sequence/v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-anthology-sequence/v0"
    },
    "sequenceId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "CANDIDATE"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "sourceIndex": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "corpusId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "corpusId"
      ],
      "additionalProperties": false
    },
    "issueCount": {
      "type": "integer",
      "minimum": 1
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1
    },
    "issueOrder": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 1
          },
          "issueSequence": {
            "type": "integer",
            "minimum": 1
          },
          "pageSequence": {
            "type": "integer",
            "minimum": 1
          },
          "issueId": {
            "type": "string",
            "minLength": 1
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "issueManifestPath": {
            "type": "string",
            "minLength": 1
          },
          "displayTitle": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "provider": {
                "const": "google-drive"
              },
              "fileId": {
                "type": "string",
                "minLength": 1
              },
              "fileName": {
                "type": "string",
                "minLength": 1
              },
              "mimeType": {
                "enum": [
                  "image/png",
                  "image/jpeg"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "provider",
              "fileId",
              "fileName",
              "mimeType",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "slot",
          "issueSequence",
          "pageSequence",
          "issueId",
          "pageId",
          "issueManifestPath",
          "displayTitle",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "authority": {
      "type": "object",
      "properties": {
        "sourceMutation": {
          "const": false
        },
        "admission": {
          "const": false
        },
        "publication": {
          "const": false
        },
        "release": {
          "const": false
        }
      },
      "required": [
        "sourceMutation",
        "admission",
        "publication",
        "release"
      ],
      "additionalProperties": false
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "sequenceId",
    "status",
    "title",
    "subtitle",
    "sourceIndex",
    "issueCount",
    "pageCount",
    "issueOrder",
    "slots",
    "authority",
    "laws"
  ],
  "additionalProperties": false
}
