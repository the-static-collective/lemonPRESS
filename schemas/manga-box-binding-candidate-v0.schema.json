{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-box-binding-candidate-v0.schema.json",
  "title": "lemonpress/manga-box-binding-candidate/v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-box-binding-candidate/v0"
    },
    "status": {
      "const": "BOUND_CANDIDATE"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "bindingId": {
      "type": "string",
      "minLength": 1
    },
    "basis": {
      "const": "declared_visual_observation"
    },
    "specSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relaySpecSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relayCandidateId": {
      "type": "string",
      "pattern": "^manga-translation-relay:[0-9a-f]{64}$"
    },
    "relayReturnTextSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pageIntakeSpecSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1
    },
    "particularCount": {
      "type": "integer",
      "minimum": 1
    },
    "bindings": {
      "type": "array",
      "minItems": 1
    },
    "surfaceCounts": {
      "type": "object"
    },
    "solidPatchReadyCount": {
      "type": "integer",
      "minimum": 0
    },
    "renderStrategyBlockers": {
      "type": "array"
    },
    "authority": {
      "type": "object"
    },
    "wrench": {
      "type": "object"
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidateId": {
      "type": "string",
      "pattern": "^manga-box-binding:[0-9a-f]{64}$"
    },
    "candidateHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "status",
    "title",
    "bindingId",
    "basis",
    "specSha256",
    "relaySpecSha256",
    "relayCandidateId",
    "relayReturnTextSha256",
    "pageIntakeSpecSha256",
    "pageCount",
    "particularCount",
    "bindings",
    "surfaceCounts",
    "solidPatchReadyCount",
    "renderStrategyBlockers",
    "authority",
    "wrench",
    "laws",
    "candidateId",
    "candidateHash"
  ],
  "additionalProperties": false
}
