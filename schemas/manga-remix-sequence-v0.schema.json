{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-remix-sequence-v0.schema.json",
  "title": "lemonpress/manga-remix-sequence/v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-remix-sequence/v0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "EXECUTION_WITNESS"
    },
    "parents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "parent_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "page",
              "panel",
              "region",
              "candidate"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "parent_id",
          "kind",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "selection": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "whole"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "region"
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "kind",
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "panel"
                  },
                  "panel_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "panel_id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "slot",
          "source_ref",
          "selection"
        ],
        "additionalProperties": false
      }
    },
    "authority": {
      "type": "object",
      "properties": {
        "editorial_selection": {
          "const": false
        },
        "edition_admission": {
          "const": false
        },
        "publication": {
          "const": false
        },
        "house_release": {
          "const": false
        }
      },
      "required": [
        "editorial_selection",
        "edition_admission",
        "publication",
        "house_release"
      ],
      "additionalProperties": false
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "status",
    "parents",
    "sequence",
    "authority",
    "laws"
  ],
  "additionalProperties": false
}
