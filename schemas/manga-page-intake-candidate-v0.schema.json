{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-page-intake-candidate-v0.schema.json",
  "title": "lemonpress/manga-page-intake-candidate/v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-page-intake-candidate/v0"
    },
    "status": {
      "const": "PAGE_CARRIERS"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intakeId": {
      "type": "string",
      "minLength": 1
    },
    "specSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object"
    },
    "sourcePdfSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "renderer": {
      "type": "object"
    },
    "admission": {
      "type": "object"
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "pageHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "pixelSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sourceImage": {
            "type": "object"
          },
          "pageManifest": {
            "type": "object"
          }
        },
        "required": [
          "page",
          "pageId",
          "pageHash",
          "width",
          "height",
          "pixelSha256",
          "sourceImage",
          "pageManifest"
        ],
        "additionalProperties": false
      }
    },
    "authority": {
      "type": "object",
      "properties": {
        "sourceAdmission": {
          "const": true
        },
        "editionAdmission": {
          "const": false
        },
        "editorialSelection": {
          "const": false
        },
        "publication": {
          "const": false
        },
        "houseRelease": {
          "const": false
        }
      },
      "required": [
        "sourceAdmission",
        "editionAdmission",
        "editorialSelection",
        "publication",
        "houseRelease"
      ],
      "additionalProperties": false
    },
    "wrench": {
      "type": "object"
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidateId": {
      "type": "string",
      "pattern": "^manga-page-intake:[0-9a-f]{64}$"
    },
    "candidateHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "status",
    "title",
    "intakeId",
    "specSha256",
    "source",
    "sourcePdfSha256",
    "renderer",
    "admission",
    "pageCount",
    "pages",
    "authority",
    "wrench",
    "laws",
    "candidateId",
    "candidateHash"
  ],
  "additionalProperties": false
}
