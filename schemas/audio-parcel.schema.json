{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/audio-parcel.schema.json",
  "title": "lemonPRESS Audio Parcel v0",
  "type": "object",
  "required": [
    "schema",
    "parcel_id",
    "identity",
    "origin",
    "roles",
    "publication_status",
    "body_policy",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "lemonpress/audio-parcel/v0"
    },
    "parcel_id": {
      "type": "string",
      "pattern": "^lp-audio-[a-f0-9]{20}$"
    },
    "identity": {
      "type": "object",
      "required": ["sha256", "byte_length", "media_type"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "filename_hint": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "required": ["system", "authority", "upstream_receipt_sha256"],
      "properties": {
        "system": {
          "enum": [
            "autodiscography-vault",
            "haunted-phonograph",
            "suno-pantry"
          ]
        },
        "authority": {
          "enum": [
            "verified-source",
            "resolved-performance-projection",
            "declared-local-export"
          ]
        },
        "upstream_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    },
    "publication_status": {
      "const": "candidate"
    },
    "body_policy": {
      "type": "object",
      "required": ["embedded", "resolution"],
      "properties": {
        "embedded": {
          "const": false
        },
        "resolution": {
          "const": "sha256"
        }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "object",
      "required": ["sources", "lineage", "projections", "receipt"],
      "properties": {
        "sources": { "const": "sources.json" },
        "lineage": { "const": "lineage.json" },
        "projections": { "const": "projections.json" },
        "receipt": { "const": "receipt.json" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
