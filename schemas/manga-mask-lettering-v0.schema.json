{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-mask-lettering-v0.schema.json",
  "title": "lemonpress/manga-mask-lettering/v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-mask-lettering/v0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "batchSpec": {
      "type": "string",
      "minLength": 1
    },
    "batchOutputCandidate": {
      "type": "string",
      "minLength": 1
    },
    "boxBindingSpec": {
      "type": "string",
      "minLength": 1
    },
    "overlays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "segmentId": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "polygonPx": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "matteRgba": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "foregroundRgba": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "style": {
            "type": "object",
            "properties": {
              "maxFontPx": {
                "type": "integer",
                "minimum": 1
              },
              "minFontPx": {
                "type": "integer",
                "minimum": 1
              },
              "paddingPx": {
                "type": "integer",
                "minimum": 0
              },
              "lineSpacingPx": {
                "type": "integer",
                "minimum": 0
              },
              "align": {
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              }
            },
            "required": [
              "maxFontPx",
              "minFontPx",
              "paddingPx",
              "lineSpacingPx",
              "align"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "segmentId",
          "page",
          "polygonPx",
          "matteRgba",
          "foregroundRgba",
          "style"
        ],
        "additionalProperties": false
      }
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "title",
    "batchSpec",
    "batchOutputCandidate",
    "boxBindingSpec",
    "overlays",
    "laws"
  ],
  "additionalProperties": false
}
