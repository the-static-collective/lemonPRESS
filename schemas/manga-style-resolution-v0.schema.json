{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "lemonpress/manga-style-resolution/v0"
    },
    "styleStackId": {
      "type": "string",
      "minLength": 1
    },
    "stackHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resolvedDomains": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "languageBehavior.sourceTraceVisible",
          "languageBehavior.routeVisible",
          "languageBehavior.glossLanguage",
          "languageBehavior.primaryLanguage",
          "textChannels.handwriting",
          "textChannels.meta_text",
          "textChannels.caption",
          "textChannels.screen_ui",
          "textChannels.title_card",
          "textChannels.signage",
          "textChannels.embedded_source_text",
          "textChannels.world_text",
          "textChannels.dialogue",
          "textChannels.sfx",
          "visualPalette.colors",
          "visualPalette.light",
          "visualPalette.contrast",
          "panelBehavior.insets",
          "panelBehavior.rhythm",
          "panelBehavior.architecture",
          "tone.warmth",
          "tone.presence",
          "tone.tension",
          "worldMotifs.rooms",
          "worldMotifs.artifacts",
          "worldMotifs.doors",
          "worldMotifs.receipts",
          "worldMotifs.screens"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "styleId": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "enum": [
              "explicit-override",
              "owner",
              "suggestion"
            ]
          }
        },
        "required": [
          "styleId",
          "rule"
        ]
      }
    },
    "resolvedBehavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languageBehavior": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primaryLanguage": {
              "type": "string",
              "minLength": 1
            },
            "glossLanguage": {
              "type": "string",
              "minLength": 1
            },
            "routeVisible": {
              "type": "boolean"
            },
            "sourceTraceVisible": {
              "type": "boolean"
            }
          },
          "required": []
        },
        "textChannels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "handwriting": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string",
                  "minLength": 1
                },
                "gloss": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "const": "witness"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "primary",
                "gloss",
                "relation",
                "purpose"
              ]
            },
            "meta_text": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string",
                  "minLength": 1
                },
                "gloss": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "const": "witness"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "primary",
                "gloss",
                "relation",
                "purpose"
              ]
            },
            "caption": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string",
                  "minLength": 1
                },
                "gloss": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "const": "witness"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "primary",
                "gloss",
                "relation",
                "purpose"
              ]
            },
            "screen_ui": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string",
                  "minLength": 1
                },
                "gloss": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "const": "witness"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "primary",
                "gloss",
                "relation",
                "purpose"
              ]
            },
            "title_card": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string",
                  "minLength": 1
                },
                "gloss": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "const": "witness"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "primary",
                "gloss",
                "relation",
                "purpose"
              ]
            },
            "signage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string",
                  "minLength": 1
                },
                "gloss": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "const": "witness"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "primary",
                "gloss",
                "relation",
                "purpose"
              ]
            },
            "embedded_source_text": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string",
                  "minLength": 1
                },
                "gloss": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "const": "witness"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "primary",
                "gloss",
                "relation",
                "purpose"
              ]
            },
            "world_text": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string",
                  "minLength": 1
                },
                "gloss": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "const": "witness"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "primary",
                "gloss",
                "relation",
                "purpose"
              ]
            },
            "dialogue": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string",
                  "minLength": 1
                },
                "gloss": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "const": "witness"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "primary",
                "gloss",
                "relation",
                "purpose"
              ]
            },
            "sfx": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string",
                  "minLength": 1
                },
                "gloss": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "const": "witness"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "primary",
                "gloss",
                "relation",
                "purpose"
              ]
            }
          },
          "required": []
        },
        "visualPalette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "light": {
              "type": "string",
              "minLength": 1
            },
            "contrast": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": []
        },
        "panelBehavior": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "insets": {
              "type": "string",
              "minLength": 1
            },
            "rhythm": {
              "type": "string",
              "minLength": 1
            },
            "architecture": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": []
        },
        "tone": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "warmth": {
              "type": "string",
              "minLength": 1
            },
            "presence": {
              "type": "string",
              "minLength": 1
            },
            "tension": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": []
        },
        "worldMotifs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rooms": {
              "type": "string",
              "minLength": 1
            },
            "artifacts": {
              "type": "string",
              "minLength": 1
            },
            "doors": {
              "type": "string",
              "minLength": 1
            },
            "receipts": {
              "type": "string",
              "minLength": 1
            },
            "screens": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": []
        }
      },
      "required": []
    },
    "appliedStyles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "styleId": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "integer"
              },
              "mode": {
                "enum": [
                  "global",
                  "channel-scoped",
                  "domain-scoped"
                ]
              },
              "domainMask": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "languageBehavior",
                    "textChannels",
                    "visualPalette",
                    "panelBehavior",
                    "tone",
                    "worldMotifs"
                  ]
                }
              },
              "channelMask": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "handwriting",
                    "meta_text",
                    "caption",
                    "screen_ui",
                    "title_card",
                    "signage",
                    "embedded_source_text",
                    "world_text",
                    "dialogue",
                    "sfx"
                  ]
                }
              },
              "overrides": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "languageBehavior.sourceTraceVisible",
                    "languageBehavior.routeVisible",
                    "languageBehavior.glossLanguage",
                    "languageBehavior.primaryLanguage",
                    "textChannels.handwriting",
                    "textChannels.meta_text",
                    "textChannels.caption",
                    "textChannels.screen_ui",
                    "textChannels.title_card",
                    "textChannels.signage",
                    "textChannels.embedded_source_text",
                    "textChannels.world_text",
                    "textChannels.dialogue",
                    "textChannels.sfx",
                    "visualPalette.colors",
                    "visualPalette.light",
                    "visualPalette.contrast",
                    "panelBehavior.insets",
                    "panelBehavior.rhythm",
                    "panelBehavior.architecture",
                    "tone.warmth",
                    "tone.presence",
                    "tone.tension",
                    "worldMotifs.rooms",
                    "worldMotifs.artifacts",
                    "worldMotifs.doors",
                    "worldMotifs.receipts",
                    "worldMotifs.screens"
                  ]
                }
              }
            },
            "required": [
              "styleId",
              "priority",
              "mode",
              "domainMask",
              "overrides"
            ]
          },
          "profileHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "entry",
          "profileHash"
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "laws": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semanticAuthority": {
          "const": false
        },
        "admission": {
          "const": false
        },
        "publication": {
          "const": false
        }
      },
      "required": [
        "semanticAuthority",
        "admission",
        "publication"
      ]
    },
    "resolutionHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "styleStackId",
    "stackHash",
    "resolvedDomains",
    "resolvedBehavior",
    "appliedStyles",
    "conflicts",
    "warnings",
    "laws",
    "authority",
    "resolutionHash"
  ]
}
