{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-translation-candidate-v0.schema.json",
  "title": "lemonpress/manga-translation-candidate/v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-translation-candidate/v0"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^manga-translation-relay:[0-9a-f]{64}$"
    },
    "status": {
      "const": "CANDIDATE"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "relay_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object"
    },
    "route": {
      "type": "array"
    },
    "source_text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pivot_text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "return_text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "segments": {
      "type": "array",
      "minItems": 1
    },
    "authority": {
      "type": "object"
    },
    "laws": {
      "type": "array",
      "minItems": 1
    },
    "wrench": {
      "type": "object",
      "properties": {
        "INPUT": {
          "type": "object"
        },
        "TRANSFORMATION": {
          "type": "string",
          "minLength": 1
        },
        "OUTPUT": {
          "type": "object"
        },
        "RESIDUAL": {
          "type": "string",
          "minLength": 1
        },
        "LOSS": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "UNKNOWN": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "STOP": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "INPUT",
        "TRANSFORMATION",
        "OUTPUT",
        "RESIDUAL",
        "LOSS",
        "UNKNOWN",
        "STOP"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "candidate_id",
    "status",
    "title",
    "relay_id",
    "source",
    "route",
    "source_text_sha256",
    "pivot_text_sha256",
    "return_text_sha256",
    "segments",
    "authority",
    "laws",
    "wrench"
  ],
  "additionalProperties": false
}
