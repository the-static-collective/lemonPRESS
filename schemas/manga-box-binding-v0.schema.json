{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-box-binding-v0.schema.json",
  "title": "lemonpress/manga-box-binding/v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-box-binding/v0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "EXECUTION_WITNESS"
    },
    "basis": {
      "const": "declared_visual_observation"
    },
    "relaySpec": {
      "type": "string",
      "minLength": 1
    },
    "pageIntakeSpec": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "segmentId": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "rectPx": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "surfaceClass": {
            "enum": [
              "solid-dark",
              "solid-light",
              "art",
              "sign"
            ]
          }
        },
        "required": [
          "segmentId",
          "page",
          "rectPx",
          "surfaceClass"
        ],
        "additionalProperties": false
      }
    },
    "authority": {
      "type": "object",
      "properties": {
        "editorialSelection": {
          "const": false
        },
        "editionAdmission": {
          "const": false
        },
        "publication": {
          "const": false
        },
        "houseRelease": {
          "const": false
        }
      },
      "required": [
        "editorialSelection",
        "editionAdmission",
        "publication",
        "houseRelease"
      ],
      "additionalProperties": false
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "status",
    "basis",
    "relaySpec",
    "pageIntakeSpec",
    "bindings",
    "authority",
    "laws"
  ],
  "additionalProperties": false
}
