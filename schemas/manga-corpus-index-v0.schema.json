{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-corpus-index-v0.schema.json",
  "title": "lemonpress/manga-corpus-index/v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-corpus-index/v0"
    },
    "corpusId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "INDEX"
    },
    "sourceShelf": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "google-drive"
        },
        "folderId": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "folderId",
        "url"
      ],
      "additionalProperties": false
    },
    "issueCount": {
      "type": "integer",
      "minimum": 1
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1
    },
    "invariants": {
      "type": "object",
      "properties": {
        "issueCount": {
          "type": "integer",
          "minimum": 1
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "issueCount",
        "pageCount"
      ],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "issueSequence": {
            "type": "integer",
            "minimum": 1
          },
          "issueId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "pageCount": {
            "type": "integer",
            "minimum": 1
          },
          "manifestPath": {
            "type": "string",
            "minLength": 1
          },
          "sourceFolderId": {
            "type": "string",
            "minLength": 1
          },
          "sourceFolderUrl": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "issueSequence",
          "issueId",
          "title",
          "pageCount",
          "manifestPath",
          "sourceFolderId",
          "sourceFolderUrl"
        ],
        "additionalProperties": false
      }
    },
    "authority": {
      "type": "object",
      "properties": {
        "admission": {
          "const": false
        },
        "publication": {
          "const": false
        },
        "release": {
          "const": false
        }
      },
      "required": [
        "admission",
        "publication",
        "release"
      ],
      "additionalProperties": false
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "corpusId",
    "title",
    "status",
    "sourceShelf",
    "issueCount",
    "pageCount",
    "invariants",
    "issues",
    "authority",
    "laws"
  ],
  "additionalProperties": false
}
