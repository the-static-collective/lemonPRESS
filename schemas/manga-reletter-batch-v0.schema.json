{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/lemonPRESS/schemas/manga-reletter-batch-v0.schema.json",
  "title": "lemonpress/manga-reletter-batch/v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lemonpress/manga-reletter-batch/v0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "boxBindingSpec": {
      "type": "string",
      "minLength": 1
    },
    "pageIntakeSpec": {
      "type": "string",
      "minLength": 1
    },
    "surfaceStyles": {
      "type": "object",
      "properties": {
        "solid-dark": {
          "$ref": "#/$defs/surface"
        },
        "solid-light": {
          "$ref": "#/$defs/surface"
        }
      },
      "required": [
        "solid-dark",
        "solid-light"
      ],
      "additionalProperties": false
    },
    "roleStyles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/role"
      }
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "title",
    "boxBindingSpec",
    "pageIntakeSpec",
    "surfaceStyles",
    "roleStyles",
    "laws"
  ],
  "additionalProperties": false,
  "$defs": {
    "rgba": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "surface": {
      "type": "object",
      "properties": {
        "backgroundRgba": {
          "$ref": "#/$defs/rgba"
        },
        "foregroundRgba": {
          "$ref": "#/$defs/rgba"
        }
      },
      "required": [
        "backgroundRgba",
        "foregroundRgba"
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "properties": {
        "maxFontPx": {
          "type": "integer",
          "minimum": 1,
          "maximum": 96
        },
        "minFontPx": {
          "type": "integer",
          "minimum": 1,
          "maximum": 96
        },
        "paddingPx": {
          "type": "integer",
          "minimum": 0
        },
        "lineSpacingPx": {
          "type": "integer",
          "minimum": 0
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        }
      },
      "required": [
        "maxFontPx",
        "minFontPx",
        "paddingPx",
        "lineSpacingPx",
        "align"
      ],
      "additionalProperties": false
    }
  }
}
